    "@storybook/builder-vite": "^8.6.4",
    "@storybook/manager-api": "^8.6.3",
    "@storybook/react": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "@storybook/test": "^8.6.0",
    "@storybook/theming": "^8.6.3",
    "@types/react": "^19.0.10",
    "eslint": "^9.21.0",
    "eslint-plugin-storybook": "^0.11.3",
    "gh-pages": "^6.3.0",
    "husky": "^8.0.0",
    "lerna": "^8.2.1",
    "prettier": "^3.5.2",
    "recast": "^0.23.11",
    "rollup": "^4.34.8",
    "rollup-plugin-dts": "^6.1.1",
