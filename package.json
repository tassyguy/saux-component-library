{
  "name": "saux-component-library",
  "version": "1.0.0",
  "description": "Monorepo for SAUX component library",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "prepublishOnly": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "deploy-storybook": "storybook build && echo > ./storybook-static/.nojekyll && gh-pages -d storybook-static",
    "local-deploy-storybook": "npm run build-storybook -- -o ./storybook-static/index.html && npx http-server ./storybook-static/index.html"
  },
  "homepage": "https://tassyguy.github.io/saux-component-library",
  "keywords": [],
  "author": "",
  "license": "ISC",
