{
  "compilerOptions": {
    "outDir": "dist",
    "declaration": true,
    "declarationDir": "dist/types",
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "target": "ES6",
    "lib": ["DOM", "ES2016"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["@testing-library/jest-dom"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.stories.tsx", "**/*.stories.ts"]
}
